# Copiar a .env y ajustar. Todos los valores tienen un default sensato:
# el proyecto arranca con SQLite y embeddings locales, sin red.

LAYERED_MEMORY_DATABASE_URL=sqlite:///./layered_memory.db

# hash = determinista y local. openai = endpoint semantico compatible.
# hybrid = top-5 semantico y RRF ponderado para los resultados restantes.
LAYERED_MEMORY_EMBEDDING_BACKEND=hash
LAYERED_MEMORY_EMBEDDING_DIM=512
LAYERED_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
LAYERED_MEMORY_EMBEDDING_BASE_URL=http://localhost:11434/v1
LAYERED_MEMORY_EMBEDDING_API_KEY=not-needed
LAYERED_MEMORY_HYBRID_LEXICAL_DIM=512
LAYERED_MEMORY_HYBRID_RANK_CONSTANT=60
LAYERED_MEMORY_HYBRID_SEMANTIC_WEIGHT=3
LAYERED_MEMORY_HYBRID_SEMANTIC_HEAD=5

LAYERED_MEMORY_RETRIEVAL_DEFAULT_K=5
LAYERED_MEMORY_WORKER_POLL_SECONDS=5

# PostgreSQL (requiere el extra "postgres")
# LAYERED_MEMORY_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/memoria
